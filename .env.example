# ===== Ask AI (Claude và/hoặc Gemini) =====
# URL endpoint đã deploy (ask-ai/worker.mjs hoặc ask-ai/server.mjs). Bỏ trống = trợ lý chỉ tra cứu tài liệu.
# Biến PUBLIC_* được nhúng vào trang, nên KHÔNG đặt khoá API ở đây.
PUBLIC_AI_ENDPOINT=

# ===== Chỉ dành cho server Ask AI (không commit) — đặt một hoặc cả hai khoá =====
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Model mặc định: claude-sonnet-5-5 / gemini-2.5-flash. Đổi nếu cần:
# ANTHROPIC_MODEL=claude-sonnet-5-5
# GEMINI_MODEL=gemini-2.5-flash
# Model mặc định khi người dùng chưa chọn (claude | gemini); bỏ trống = model đầu tiên có khoá
# AI_PROVIDER=claude
# ALLOWED_ORIGIN=https://docs.example.com
# PORT=8787

# URL công khai khi deploy site (tuỳ chọn)
SITE_URL=
BASE_PATH=
