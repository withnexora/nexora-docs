---
return Astro.redirect('/vi/', 302);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    
    <!-- Primary SEO & Browser Meta Redirect -->
    <meta http-equiv="refresh" content={`${delaySeconds};url=${targetUrl}`} />
    <link rel="canonical" href={targetUrl} />

    <style define:vars={{ delay: `${delaySeconds}s` }}>
      :root {
        --bg-color: #f8fafc;
        --card-bg: #ffffff;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --accent: #6366f1;
        --border: #e2e8f0;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg-color: #09090b;
          --card-bg: #18181b;
          --text-main: #f8fafc;
          --text-muted: #a1a1aa;
          --accent: #818cf8;
          --border: #27272a;
        }
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background-color: var(--bg-color);
        color: var(--text-main);
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 1.5rem;
      }

      .card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 1rem;
        padding: 2.5rem 2rem;
        max-width: 420px;
        width: 100%;
        text-align: center;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
      }

      .icon-wrapper {
        width: 48px;
        height: 48px;
        margin: 0 auto 1.25rem;
        border-radius: 12px;
        background: color-mix(in srgb, var(--accent) 15%, transparent);
        color: var(--accent);
        display: flex;
        align-items: center;
        justify-content: center;
      }

      h1 {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        letter-spacing: -0.02em;
      }

      p {
        color: var(--text-muted);
        font-size: 0.925rem;
        line-height: 1.5;
        margin-bottom: 1.5rem;
      }

      .progress-track {
        width: 100%;
        height: 4px;
        background: var(--border);
        border-radius: 999px;
        overflow: hidden;
        margin-bottom: 1.5rem;
      }

      .progress-fill {
        height: 100%;
        width: 0%;
        background: var(--accent);
        border-radius: 999px;
        animation: fillProgress var(--delay) linear forwards;
      }

      @keyframes fillProgress {
        from { width: 0%; }
        to { width: 100%; }
      }

      .fallback-link {
        display: inline-block;
        font-size: 0.85rem;
        color: var(--accent);
        text-decoration: none;
        font-weight: 500;
        transition: opacity 0.2s ease;
      }

      .fallback-link:hover {
        opacity: 0.8;
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <main class="card">
      <div class="icon-wrapper">
        <svg xmlns="http://w3.org" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </div>

      <h1>Taking you to the new page</h1>
      <p>You will be automatically redirected in a few seconds.</p>

      <div class="progress-track">
        <div class="progress-fill"></div>
      </div>

      <a href={targetUrl} class="fallback-link">
        Click here if you are not redirected &rarr;
      </a>
    </main>

    <!-- Reliable JS Fallback -->
    <script define:vars={{ targetUrl, delaySeconds }}>
      setTimeout(() => {
        window.location.replace(targetUrl);
      }, delaySeconds * 1000);
    </script>
  </body>
</html>
