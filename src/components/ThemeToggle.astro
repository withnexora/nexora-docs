---
// Nút chuyển Light ⇄ Dark (thay cho dropdown Auto/Light/Dark mặc định của Starlight)
---

<starlight-theme-toggle>
  <button type="button" class="nx-theme-toggle" aria-label="Chuyển giao diện sáng / tối" title="Light / Dark">
    <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
    </svg>
    <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
    </svg>
  </button>
</starlight-theme-toggle>

<script>
  class StarlightThemeToggle extends HTMLElement {
    connectedCallback() {
      this.querySelector('button')?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'light' ? 'dark' : 'light';
        root.dataset.theme = next;
        try {
          localStorage.setItem('starlight-theme', next);
        } catch {}
      });
    }
  }
  customElements.define('starlight-theme-toggle', StarlightThemeToggle);
</script>

<style>
  .nx-theme-toggle {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    border: 1px solid var(--nx-glass-border, var(--sl-color-hairline));
    background: var(--nx-glass-bg, transparent);
    color: var(--sl-color-text-accent);
    cursor: pointer;
    box-shadow: inset 0 1px 0 var(--nx-glass-highlight, transparent);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .nx-theme-toggle:hover {
    transform: rotate(12deg) scale(1.06);
  }
  :global(:root[data-theme='light']) .icon-moon,
  :global(:root:not([data-theme='light'])) .icon-sun {
    display: none;
  }
</style>
